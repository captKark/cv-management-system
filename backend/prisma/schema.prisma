generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cvs          CV[]
}
model Position {
  id          Int      @id @default(autoincrement())
  title       String
  department  String
  location    String
  status      String

  visibility  String   @default("Public")
  projectTag  String?
  maxProjects Int      @default(5)
  description String?

  attributes  PositionAttribute[]
}

model CV {
  id              Int    @id @default(autoincrement())

  candidateId     Int
  positionId      Int

  positionTitle   String
  status          String
  updatedAt       String

  candidate       User @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  attributeValues CVAttributeValue[]
}

model CVAttributeValue {
  id          Int       @id @default(autoincrement())

  cvId        Int
  attributeId Int

  value       String    @default("")

  cv          CV        @relation(fields: [cvId], references: [id], onDelete: Cascade)
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([cvId, attributeId])
}
model Attribute {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String
  type      String
  createdAt DateTime @default(now())

  positions PositionAttribute[]
  cvValues CVAttributeValue[]
  templateAttributes TemplateAttribute[]
}

model PositionAttribute {
  positionId  Int
  attributeId Int

  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([positionId, attributeId])
}
model Template {
  id          Int      @id @default(autoincrement())
  name        String
  department  String
  location    String
  visibility  String   @default("Public")
  projectTag  String?
  maxProjects Int      @default(5)
  description String?

  createdAt   DateTime @default(now())

  attributes  TemplateAttribute[]
}

model TemplateAttribute {
  templateId  Int
  attributeId Int

  template  Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([templateId, attributeId])
}